# Export these settings in your shell or service manager.
# serve-avd does not automatically load this file.
SERVE_AVD_AUTH_DATABASE=/var/lib/serve-avd/auth/accounts.sqlite
SERVE_AVD_AUTH_ORIGIN=http://localhost:3200

# Optional settings for ops/dev-server.mjs
SERVE_AVD_HOST=127.0.0.1
SERVE_AVD_PORT=3200

# Provision credentials interactively with serve-avd auth-bootstrap.
