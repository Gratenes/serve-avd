{
  "name": "serve-avd",
  "version": "0.1.3",
  "description": "The `npx serve` of Android Emulators \u2014 stream any emulator to the browser with full interaction, no instrumentation.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hsandhu/serve-avd.git"
  },
  "homepage": "https://github.com/hsandhu/serve-avd#readme",
  "bugs": {
    "url": "https://github.com/hsandhu/serve-avd/issues"
  },
  "keywords": [
    "android",
    "emulator",
    "adb",
    "screen-mirroring",
    "mjpeg",
    "h264",
    "webcodecs",
    "preview",
    "agent",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "uiautomator",
    "test-automation"
  ],
  "bin": {
    "serve-avd": "dist/serve-avd.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist/serve-avd.js",
    "dist/middleware.js",
    "dist/middleware.cjs",
    "dist/sdk.js",
    "dist/sdk.cjs",
    "dist/client.js",
    "dist/client.css",
    "dist/font-licenses",
    "src/middleware.ts",
    "src/state.ts",
    "src/sdk.ts",
    "src/ax.ts",
    "src/adb.ts",
    "src/actions.ts",
    "src/replay.ts",
    "src/auth.ts",
    "src/auth-page.ts"
  ],
  "exports": {
    "./middleware": {
      "types": "./src/middleware.ts",
      "import": "./dist/middleware.js",
      "require": "./dist/middleware.cjs"
    },
    "./client": {
      "types": "./src/sdk.ts",
      "import": "./dist/sdk.js",
      "require": "./dist/sdk.cjs"
    },
    "./state": {
      "types": "./src/state.ts",
      "import": "./src/state.ts"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build",
    "test:browser": "npm run build && node --test test/browser*.test.mjs"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "commander": "^14.0.1",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.11.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "playwright": "1.61.1",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}
